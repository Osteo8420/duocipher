# Optionnel : ne sert que si le front et le relais tournent sur deux
# hébergeurs différents (ex. front sur Vercel, relais sur un VPS à part).
# Si tu suis le déploiement combiné (voir relay-server/README.md, un seul
# serveur sert le front ET le relais), laisse cette variable vide/absente :
# l'app se connecte alors automatiquement à sa propre origine.
VITE_RELAY_URL=ws://localhost:8080
